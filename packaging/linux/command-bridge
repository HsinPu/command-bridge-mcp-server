#!/usr/bin/env bash
# CommandBridge managed administration launcher.
set -euo pipefail
if [[ "${1:-}" == update ]]; then
  shift
  exec bash "__INSTALL_ROOT__/current/bootstrap.sh" --update "$@"
fi
if [[ $# != 1 || ( "$1" != --version && "$1" != -V ) ]]; then
  printf 'Usage: command-bridge --version | -V | update [--check|--print-codex-setup]\n' >&2
  exit 2
fi
exec "__INSTALL_ROOT__/runtime/current/bin/node" "__INSTALL_ROOT__/current/dist/index.js" "$1"
