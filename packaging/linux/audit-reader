#!/bin/bash

set -euo pipefail

# This root-owned helper accepts no arguments. The service account can invoke
# it only through one exact sudoers entry, and it emits only this service's
# compact CommandBridge Audit JSON messages (not arbitrary service logs).
# Read the latest service entries and filter locally: journalctl --grep exits
# with status 1 when a fresh installation has no matching events. pipefail
# preserves actual journal read failures while awk accepts an empty result.
/usr/bin/journalctl \
  --no-pager \
  --unit command-bridge-mcp-server.service \
  --output=cat \
  --lines=1000 |
  /usr/bin/awk '/^{"schemaVersion":1,"event":"command_bridge\.audit",/'
