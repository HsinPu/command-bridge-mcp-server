[Unit]
Description=CommandBridge MCP Server
Documentation=https://github.com/HsinPu/command-bridge-mcp-server
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=command-bridge
Group=command-bridge
WorkingDirectory=/usr/local/lib/command-bridge/current
Environment=NODE_ENV=production
Environment=HOME=/var/empty/command-bridge
Environment=DOTENV_CONFIG_PATH=/dev/null
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=/etc/command-bridge/command-bridge.env
ExecStart=/usr/local/lib/command-bridge/runtime/current/bin/node /usr/local/lib/command-bridge/current/dist/index.js

Restart=on-failure
RestartSec=5
TimeoutStartSec=20
TimeoutStopSec=20
KillMode=control-group
UMask=0077
LimitCORE=0
LimitNOFILE=1024
TasksMax=128
MemoryMax=512M

StateDirectory=command-bridge
StateDirectoryMode=0750
ReadWritePaths=/var/lib/command-bridge/work /var/lib/command-bridge-update

# Root-owned, no-argument Audit and update-request helpers are authorized by
# separate restricted sudoers rules. Updates run in a separate systemd unit.
# Keep the service account out of sudo and systemd-journal groups; do not grant
# any general sudo command. Seccomp-based hardening and PrivateDevices imply
# NoNewPrivileges even when explicitly false, and therefore block this reader.
NoNewPrivileges=false
PrivateTmp=true
DevicePolicy=closed
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
RemoveIPC=true
# Permit sudo's UID/GID transition for the fixed helpers. These are only
# a ceiling; the unprivileged Node process receives no ambient capabilities.
CapabilityBoundingSet=CAP_SETUID CAP_SETGID
AmbientCapabilities=

StandardOutput=journal
StandardError=journal
SyslogIdentifier=command-bridge

[Install]
WantedBy=multi-user.target
