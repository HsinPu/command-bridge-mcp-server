[Unit]
Description=CommandBridge independent managed update
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=command-bridge
UMask=0027
ExecStart=/usr/local/lib/command-bridge/runtime/current/bin/node /usr/local/libexec/command-bridge-update/state.mjs run
ExecStopPost=/usr/local/lib/command-bridge/runtime/current/bin/node /usr/local/libexec/command-bridge-update/state.mjs finish
TimeoutStartSec=2700
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
