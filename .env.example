# stdio for a local MCP client; http for a remote MCP endpoint.
COMMAND_BRIDGE_TRANSPORT=stdio

# Required in HTTP mode. Generate at least 32 random characters.
COMMAND_BRIDGE_BEARER_TOKEN=
COMMAND_BRIDGE_HTTP_HOST=127.0.0.1
COMMAND_BRIDGE_HTTP_PORT=8800

# Required when HTTP_HOST is not a loopback address. Comma-separated Host values.
COMMAND_BRIDGE_ALLOWED_HOSTS=

# allowlist is the safe default. unrestricted permits arbitrary shell syntax.
COMMAND_BRIDGE_EXECUTION_MODE=allowlist

# Optional comma-separated overrides. Defaults depend on the host OS.
COMMAND_BRIDGE_ALLOWED_SHELLS=
COMMAND_BRIDGE_ALLOWED_COMMANDS=

# Working-directory roots, separated by the OS path delimiter (: on Linux, ; on Windows).
# Defaults to the directory where the MCP server starts.
COMMAND_BRIDGE_ALLOWED_ROOTS=

COMMAND_BRIDGE_DEFAULT_TIMEOUT_MS=15000
COMMAND_BRIDGE_MAX_TIMEOUT_MS=60000
COMMAND_BRIDGE_MAX_OUTPUT_CHARS=50000
COMMAND_BRIDGE_MAX_PARALLEL_COMMANDS=2

# Optional comma-separated environment variable names inherited by child processes.
COMMAND_BRIDGE_PASSTHROUGH_ENV=
